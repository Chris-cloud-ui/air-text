<div class="prediction <%= css_name %>">
  <dl class="summary">
    <dt class="name"><%= name %></dt>
    <dd class="display-value mr-2"><%= display_value&.html_safe %></dd>
  </dl>
  <% if guidance_visible? %>
  <div class="guidance">
    <%= render(HealthGuidanceComponent.new(css_name.to_sym, (level_label || "low").parameterize(separator: "_").to_sym, classes: ["mb-3"])) %>
    <p><%= link_to "Learn more about the #{sentence_name} alert", health_advice_path, class: "a" %></p>
  </div>
  <% end %>
</div>
