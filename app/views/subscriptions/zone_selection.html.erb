<%= render 'form_step' do |f| %>
  <div id="zone-selection-page">
    <section class="text-block">
      <h3>Enter places you'd like to receive alerts for</h3>
      <p>You can get alerts for up to 2 areas.</p>
      <p>Search to select your areas.</p>
    
      <%= f.label :zone_search, "Enter a place, address or postcode", class: "sr-only" %>
      <%= f.text_field :zone_search, 
        class: "mb-2",
        placeholder: "Enter a place, address or postcode",
        type: "search", 
        data: { 
          action: "subscription#search", 
          "subscription-target": "searchField",
          "maptiler-api-key": ENV["MAPTILER_API_KEY"] 
        } %>
      <div id="zone-tags" class="mb-2">
        <ul id="search-results" data-subscription-target="searchResults" class="hidden"></ul>
        <ul id="selected-zones" data-subscription-target="selectedZones"></ul>
      </div>
    </section>

    <section>
      <h3 class="mb-2">Or choose areas from the list.</h3>
      <div>
        <% ZoneGroup.all.order(:order).each do |group| %>
        <details class="zone-region-group details-compact">
          <summary class="p-2">
            <h4><%= group.name %></h4>
            <%= content_tag :p, group.description, class: "mt-1" if group.description.present? %>
          </summary>
          <div class="zone-checkboxes p-2">
            <% group.zones.order(cerc_type: :desc, name: :asc).group_by(&:cerc_type).each do |level, zones| %>
              <div class="zone-level-group zone-level-group-<%= level %>">
                <% zones.group_by{ |z| z.name[0] }.each do |letter, zones| %>
                  <div class="zone-letter-group">
                    <%= f.collection_check_boxes :zones, zones, :name, :name, { multiple: true } do |b| %>
                      <div class="checkbox-wrapper">
                        <%= b.check_box %>
                        <%= b.label %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </details>
        <% end %>
      </div>
    </section>
  </div>
<% end %>
